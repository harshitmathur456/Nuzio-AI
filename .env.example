# ==============================================================================
# Nuzio AI — Environment Configuration
# ==============================================================================

# Supabase Project URL & Anon Key (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: If no keys are provided, Nuzio AI runs in instant Demo Mode
# with local cookie-based session and preference persistence so you can test immediately.
